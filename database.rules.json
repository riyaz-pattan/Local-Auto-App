{
  "rules": {
    ".read": false,
    ".write": false,
    "app_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "broadcasts": {
      ".read": true,
      ".write": "auth != null"
    },
    "drivers_index": {
      ".read": "auth != null",
      ".write": false
    },
    "liveLocations": {
      ".read": "auth != null",
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    }
  }
}
